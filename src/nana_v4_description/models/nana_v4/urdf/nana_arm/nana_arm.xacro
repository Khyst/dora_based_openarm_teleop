<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Reusable Nana Arm / OpenArm Macro based on nana_v3_corrected.urdf and nana_v4_description meshes
    Parameters:
      - prefix: Prefix for links and joints (e.g. "nana_v4_left_", "left_arm_", etc.)
      - parent: Parent link to attach the arm base link (link0) to
      - side: "left" or "right" (determines arm symmetry, mesh y-scale, joint origins/axes, and inertias)
      - *origin: Origin transform block specifying position and orientation relative to parent link
      - description_pkg: ROS package name containing arm mesh assets (default: "nana_v4_description")
  -->
  <xacro:macro name="nana_arm" params="prefix parent side:='left' *origin description_pkg:='nana_v4_description'">

    <xacro:if value="${side == 'left'}">
      <xacro:property name="scale_y" value="-0.001"/>
      <xacro:property name="joint2_rpy" value="-1.57079632679 0 0"/>
      <xacro:property name="joint7_axis" value="0 -1 0"/>
    </xacro:if>
    <xacro:unless value="${side == 'left'}">
      <xacro:property name="scale_y" value="0.001"/>
      <xacro:property name="joint2_rpy" value="1.57079632679 0 0"/>
      <xacro:property name="joint7_axis" value="0 1 0"/>
    </xacro:unless>

    <!-- Base Joint attaching arm link0 to parent link -->
    <joint name="${prefix}joint_base" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}link0"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- Link 0 -->
    <link name="${prefix}link0">
      <visual name="${prefix}link0_visual">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/visual/arm_link0.dae" scale="0.001 ${scale_y} 0.001"/>
        </geometry>
      </visual>
      <collision name="${prefix}link0_collision">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/collision/arm_link0_symp.stl" scale="0.001 ${scale_y} 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <xacro:if value="${side == 'left'}">
          <origin rpy="0.0 0.0 0.0" xyz="-0.0009483362816297526 -0.0001580207020448382 0.03076860287587199"/>
          <mass value="1.1432284943239561"/>
          <inertia ixx="0.001128" ixy="4e-06" ixz="-3.3e-05" iyy="0.000962" iyz="7e-06" izz="0.00147"/>
        </xacro:if>
        <xacro:unless value="${side == 'left'}">
          <origin rpy="0.0 0.0 0.0" xyz="-0.0009483362816297526 0.0001580207020448382 0.03076860287587199"/>
          <mass value="1.1432284943239561"/>
          <inertia ixx="0.001128" ixy="-4e-06" ixz="-3.3e-05" iyy="0.000962" iyz="-7e-06" izz="0.00147"/>
        </xacro:unless>
      </inertial>
    </link>

    <!-- Joint 1 -->
    <joint name="${prefix}joint1" type="revolute">
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0625"/>
      <parent link="${prefix}link0"/>
      <child link="${prefix}link1"/>
      <axis xyz="0 0 1"/>
      <limit effort="40" lower="-1.396263" upper="3.490659" velocity="16.754666"/>
    </joint>

    <!-- Link 1 -->
    <link name="${prefix}link1">
      <visual name="${prefix}link1_visual">
        <origin rpy="0.0 0.0 0.0" xyz="-0.0 0.0 -0.0625"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/visual/arm_link1.dae" scale="0.001 ${scale_y} 0.001"/>
        </geometry>
      </visual>
      <collision name="${prefix}link1_collision">
        <origin rpy="0.0 0.0 0.0" xyz="-0.0 0.0 -0.0625"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/collision/arm_link1_symp.stl" scale="0.001 ${scale_y} 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <xacro:if value="${side == 'left'}">
          <origin rpy="0.0 0.0 0.0" xyz="0.0011467657911800769 -3.319987657026362e-05 0.05395284380736254"/>
          <mass value="1.1416684646202298"/>
          <inertia ixx="0.001567" ixy="1e-06" ixz="-2.9e-05" iyy="0.001273" iyz="-1e-06" izz="0.001016"/>
        </xacro:if>
        <xacro:unless value="${side == 'left'}">
          <origin rpy="0.0 0.0 0.0" xyz="0.0011467657911800769 3.319987657026362e-05 0.05395284380736254"/>
          <mass value="1.1416684646202298"/>
          <inertia ixx="0.001567" ixy="-1e-06" ixz="-2.9e-05" iyy="0.001273" iyz="1e-06" izz="0.001016"/>
        </xacro:unless>
      </inertial>
    </link>

    <!-- Joint 2 -->
    <joint name="${prefix}joint2" type="revolute">
      <origin rpy="${joint2_rpy}" xyz="-0.0301 0.0 0.06"/>
      <parent link="${prefix}link1"/>
      <child link="${prefix}link2"/>
      <axis xyz="-1 0 0"/>
      <limit effort="40" lower="-1.745329" upper="1.745329" velocity="16.754666"/>
    </joint>

    <!-- Link 2 -->
    <link name="${prefix}link2">
      <visual name="${prefix}link2_visual">
        <origin rpy="0.0 0.0 0.0" xyz="0.0301 0.0 -0.1225"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/visual/arm_link2.dae" scale="0.001 ${scale_y} 0.001"/>
        </geometry>
      </visual>
      <collision name="${prefix}link2_collision">
        <origin rpy="0.0 0.0 0.0" xyz="0.0301 0.0 -0.1225"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/collision/arm_link2_symp.stl" scale="0.001 ${scale_y} 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <xacro:if value="${side == 'left'}">
          <origin rpy="0.0 0.0 0.0" xyz="0.00839629182351943 2.0145102027597523e-08 0.03256649300522363"/>
          <mass value="0.2775092746011571"/>
          <inertia ixx="0.000359" ixy="-1e-06" ixz="-0.000109" iyy="0.000376" iyz="-1e-06" izz="0.000232"/>
        </xacro:if>
        <xacro:unless value="${side == 'left'}">
          <origin rpy="0.0 0.0 0.0" xyz="0.00839629182351943 -2.0145102027597523e-08 0.03256649300522363"/>
          <mass value="0.2775092746011571"/>
          <inertia ixx="0.000359" ixy="1e-06" ixz="-0.000109" iyy="0.000376" iyz="1e-06" izz="0.000232"/>
        </xacro:unless>
      </inertial>
    </link>

    <!-- Joint 3 -->
    <joint name="${prefix}joint3" type="revolute">
      <origin rpy="0 0 0" xyz="0.0301 0.0 0.06625"/>
      <parent link="${prefix}link2"/>
      <child link="${prefix}link3"/>
      <axis xyz="0 0 1"/>
      <limit effort="27" lower="-1.570796" upper="1.570796" velocity="5.445426"/>
    </joint>

    <!-- Link 3 -->
    <link name="${prefix}link3">
      <visual name="${prefix}link3_visual">
        <origin rpy="0.0 0.0 0.0" xyz="-0.0 -0.0 -0.18875"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/visual/arm_link3.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>
      <collision name="${prefix}link3_collision">
        <origin rpy="0.0 0.0 0.0" xyz="-0.0 -0.0 -0.18875"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/collision/arm_link3_symp.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin rpy="0.0 0.0 0.0" xyz="-0.002104752099628911 0.0005549085042607548 0.09047470545721961"/>
        <mass value="1.073863338202347"/>
        <inertia ixx="0.004372" ixy="1e-06" ixz="1.1e-05" iyy="0.004319" iyz="-3.6e-05" izz="0.000661"/>
      </inertial>
    </link>

    <!-- Joint 4 -->
    <joint name="${prefix}joint4" type="revolute">
      <origin rpy="0 0 0" xyz="-0.0 0.0315 0.15375"/>
      <parent link="${prefix}link3"/>
      <child link="${prefix}link4"/>
      <axis xyz="0 1 0"/>
      <limit effort="27" lower="0.0" upper="2.443461" velocity="5.445426"/>
    </joint>

    <!-- Link 4 -->
    <link name="${prefix}link4">
      <visual name="${prefix}link4_visual">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 -0.0315 -0.3425"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/visual/arm_link4.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>
      <collision name="${prefix}link4_collision">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 -0.0315 -0.3425"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/collision/arm_link4_symp.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin rpy="0.0 0.0 0.0" xyz="-0.0029006831074562967 -0.03030575826634669 0.06339637422196209"/>
        <mass value="0.6348534566833373"/>
        <inertia ixx="0.000623" ixy="-1e-06" ixz="-1.9e-05" iyy="0.000511" iyz="3.8e-05" izz="0.000334"/>
      </inertial>
    </link>

    <!-- Joint 5 -->
    <joint name="${prefix}joint5" type="revolute">
      <origin rpy="0 0 0" xyz="0.0 -0.0315 0.0955"/>
      <parent link="${prefix}link4"/>
      <child link="${prefix}link5"/>
      <axis xyz="0 0 1"/>
      <limit effort="7" lower="-1.570796" upper="1.570796" velocity="20.943946"/>
    </joint>

    <!-- Link 5 -->
    <link name="${prefix}link5">
      <visual name="${prefix}link5_visual">
        <origin rpy="0.0 0.0 0.0" xyz="-0.0 -0.0 -0.438"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/visual/arm_link5.dae" scale="0.001 ${scale_y} 0.001"/>
        </geometry>
      </visual>
      <collision name="${prefix}link5_collision">
        <origin rpy="0.0 0.0 0.0" xyz="-0.0 -0.0 -0.438"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/collision/arm_link5_symp.stl" scale="0.001 ${scale_y} 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <xacro:if value="${side == 'left'}">
          <origin rpy="0.0 0.0 0.0" xyz="-0.003049665024221911 -0.0008866902457326625 0.043079803024980934"/>
          <mass value="0.6156588026168502"/>
          <inertia ixx="0.000423" ixy="8e-06" ixz="6e-06" iyy="0.000445" iyz="6e-06" izz="0.000324"/>
        </xacro:if>
        <xacro:unless value="${side == 'left'}">
          <origin rpy="0.0 0.0 0.0" xyz="-0.003049665024221911 0.0008866902457326625 0.043079803024980934"/>
          <mass value="0.6156588026168502"/>
          <inertia ixx="0.000423" ixy="-8e-06" ixz="6e-06" iyy="0.000445" iyz="-6e-06" izz="0.000324"/>
        </xacro:unless>
      </inertial>
    </link>

    <!-- Joint 6 -->
    <joint name="${prefix}joint6" type="revolute">
      <origin rpy="0 0 0" xyz="0.0375 0.0 0.1205"/>
      <parent link="${prefix}link5"/>
      <child link="${prefix}link6"/>
      <axis xyz="1 0 0"/>
      <limit effort="7" lower="-0.785398" upper="0.785398" velocity="20.943946"/>
    </joint>

    <!-- Link 6 -->
    <link name="${prefix}link6">
      <visual name="${prefix}link6_visual">
        <origin rpy="0.0 0.0 0.0" xyz="-0.0375 -0.0 -0.5585"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/visual/arm_link6.dae" scale="0.001 ${scale_y} 0.001"/>
        </geometry>
      </visual>
      <collision name="${prefix}link6_collision">
        <origin rpy="0.0 0.0 0.0" xyz="-0.0375 -0.0 -0.5585"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/collision/arm_link6_symp.stl" scale="0.001 ${scale_y} 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <xacro:if value="${side == 'left'}">
          <origin rpy="0.0 0.0 0.0" xyz="-0.037136587005447405 -0.00033230528343419053 -9.498374522309838e-05"/>
          <mass value="0.475202773187987"/>
          <inertia ixx="0.000143" ixy="-1e-06" ixz="1e-06" iyy="0.000157" iyz="-1e-06" izz="0.000159"/>
        </xacro:if>
        <xacro:unless value="${side == 'left'}">
          <origin rpy="0.0 0.0 0.0" xyz="-0.037136587005447405 0.00033230528343419053 -9.498374522309838e-05"/>
          <mass value="0.475202773187987"/>
          <inertia ixx="0.000143" ixy="1e-06" ixz="1e-06" iyy="0.000157" iyz="1e-06" izz="0.000159"/>
        </xacro:unless>
      </inertial>
    </link>

    <!-- Joint 7 -->
    <joint name="${prefix}joint7" type="revolute">
      <origin rpy="0 0 0" xyz="-0.0375 0.0 0.0"/>
      <parent link="${prefix}link6"/>
      <child link="${prefix}link7"/>
      <axis xyz="${joint7_axis}"/>
      <limit effort="7" lower="-1.570796" upper="1.570796" velocity="20.943946"/>
    </joint>

    <!-- Link 7 -->
    <link name="${prefix}link7">
      <visual name="${prefix}link7_visual">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 -0.0 -0.5585"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/visual/arm_link7.dae" scale="0.001 ${scale_y} 0.001"/>
        </geometry>
      </visual>
      <collision name="${prefix}link7_collision">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 -0.0 -0.5585"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/collision/arm_link7_symp.stl" scale="0.001 ${scale_y} 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <xacro:if value="${side == 'left'}">
          <origin rpy="0.0 0.0 0.0" xyz="6.875510271106056e-05 -0.01266175250761268 0.06951945409987448"/>
          <mass value="0.4659771327380578"/>
          <inertia ixx="0.000639" ixy="-1e-06" ixz="1e-06" iyy="0.000497" iyz="-8.9e-05" izz="0.000342"/>
        </xacro:if>
        <xacro:unless value="${side == 'left'}">
          <origin rpy="0.0 0.0 0.0" xyz="6.875510271106056e-05 0.01266175250761268 0.06951945409987448"/>
          <mass value="0.4659771327380578"/>
          <inertia ixx="0.000639" ixy="1e-06" ixz="1e-06" iyy="0.000497" iyz="8.9e-05" izz="0.000342"/>
        </xacro:unless>
      </inertial>
    </link>

    <!-- Custom Hand (Temporary placeholder for end effector) -->
    <link name="${prefix}hand">
      <inertial>
        <mass value="0.1"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <box size="0.01 0.01 0.01"/>
        </geometry>
        <material name="grey">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <box size="0 0 0"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}hand_joint" type="fixed">
      <parent link="${prefix}link7"/>
      <child link="${prefix}hand"/>
      <origin rpy="0 0 0" xyz="0 0 0.08"/>
    </joint>

  </xacro:macro>

</robot>
