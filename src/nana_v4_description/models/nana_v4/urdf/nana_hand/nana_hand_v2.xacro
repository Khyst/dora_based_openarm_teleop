<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Global properties for Nana Hand v2 -->
  <xacro:property name="hand_grasp_min" value="-45.0"/>
  <xacro:property name="hand_grasp_max" value="0.0"/>

  <xacro:macro name="gazebo_contact_settings" params="ref_link contacts:=5">
    <gazebo reference="${ref_link}">
      <mu1>10000.0</mu1>
      <mu2>10000.0</mu2>
      <kp>1000000.0</kp>
      <kd>1.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.0</maxVel>
      <maxContacts>${contacts}</maxContacts>
    </gazebo>
  </xacro:macro>

  <!--
    Reusable Nana Hand v2 Macro with Left/Right Mirroring Support
    Parameters:
      - prefix: Prefix for links and joints (e.g. "left_hand_", "right_hand_")
      - parent: Parent link to attach the hand (palm) to
      - side: "left" or "right" (determines symmetry, y-scale for left-based meshes, and joint mirroring)
      - *origin: Origin transform block specifying position and orientation relative to parent link
      - description_pkg: ROS package name containing hand mesh assets (default: "nana_v4_description")
  -->
  <xacro:macro name="nana_hand_v2" params="prefix parent side:='left' *origin description_pkg:='nana_v4_description'">

    <xacro:if value="${side == 'left'}">
      <xacro:property name="scale_y" value="1."/>
      <xacro:property name="sign_y" value="1"/>
    </xacro:if>
    <xacro:unless value="${side == 'left'}">
      <xacro:property name="scale_y" value="-1."/>
      <xacro:property name="sign_y" value="-1"/>
    </xacro:unless>

    <!-- Palm Base Joint -->
    <joint name="${prefix}palm_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}palm"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- Palm Link -->
    <link name="${prefix}palm">
      <visual name="${prefix}palm_visual">
        <origin xyz="-0.0033364 ${sign_y * 0.0723848} 0.0007459" rpy="-3.1241558 0.0103718 3.1384223"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/visual/palm_01.obj" scale="1. ${scale_y} 1."/>
        </geometry>
        <material name="grey">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
      <collision name="${prefix}palm_collision">
        <origin xyz="-0.0033364 ${sign_y * 0.0723848} 0.0007459" rpy="-3.1241558 0.0103718 3.1384223"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/collision/palm_01_collision.stl" scale="1. ${scale_y} 1."/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.29386"/>
        <inertia ixx="0.00019145" ixy="${sign_y * -0.00002619}" ixz="-0.00008456" iyy="0.00048185" iyz="${sign_y * 0.00000299}" izz="0.00037654"/>
      </inertial>
    </link>
    <xacro:gazebo_contact_settings ref_link="${prefix}palm" contacts="5"/>

    <!-- TCP Joint and Link -->
    <joint name="${prefix}tcp_joint" type="fixed">
      <origin xyz="-0.01 ${sign_y * 0.09} -0.0275" rpy="0 0 0"/>
      <parent link="${prefix}palm"/>
      <child link="${prefix}tcp"/>
    </joint>

    <link name="${prefix}tcp">
      <visual name="${prefix}tcp_visual">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.005"/>
        </geometry>
        <material name="grey">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
    </link>

    <!-- Index Finger 01 -->
    <joint name="${prefix}index_finger_joint_01" type="revolute">
      <origin xyz="0.0217436 ${sign_y * 0.119301} 0.0161281" rpy="-0.2268928 0. 0."/>
      <parent link="${prefix}palm"/>
      <child link="${prefix}index_finger_01"/>
      <axis xyz="1. 0. 0."/>
      <limit lower="${radians(hand_grasp_min)}" upper="${radians(hand_grasp_max)}" effort="10" velocity="1"/>
      <dynamics damping="0.1" friction="0.1"/>
      <mimic joint="${prefix}thumb_finger_joint_01" multiplier="1.0" offset="0"/>
    </joint>

    <link name="${prefix}index_finger_01">
      <visual name="${prefix}index_finger_01_visual">
        <origin xyz="0 ${sign_y * 0.0208} 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/visual/index_finger_01.obj" scale="1. ${scale_y} 1."/>
        </geometry>
        <material name="grey">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
      <collision name="${prefix}index_finger_01_collision">
        <origin xyz="0 ${sign_y * 0.0208} 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/collision/index_finger_01_collision.stl" scale="1. ${scale_y} 1."/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.00528"/>
        <inertia ixx="2.8081e-07" ixy="${sign_y * -1.3729e-07}" ixz="1.7500e-09" iyy="6.4957e-07" iyz="${sign_y * -1.9000e-10}" izz="6.6087e-07"/>
      </inertial>
    </link>
    <xacro:gazebo_contact_settings ref_link="${prefix}index_finger_01" contacts="5"/>

    <!-- Index Finger 02 -->
    <joint name="${prefix}index_finger_joint_02" type="revolute">
      <origin xyz="-0.0005 ${sign_y * 0.0416113} -0.0006191" rpy="-0.6981317 0. 0."/>
      <parent link="${prefix}index_finger_01"/>
      <child link="${prefix}index_finger_02"/>
      <axis xyz="1. 0. 0."/>
      <limit lower="${radians(hand_grasp_min)}" upper="${radians(hand_grasp_max)}" effort="10" velocity="1"/>
      <dynamics damping="0.1" friction="0.1"/>
      <mimic joint="${prefix}thumb_finger_joint_01" multiplier="1.0" offset="0"/>
    </joint>

    <link name="${prefix}index_finger_02">
      <visual name="${prefix}index_finger_02_visual">
        <origin xyz="0 ${sign_y * 0.02} 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/visual/index_finger_02.obj" scale="1. ${scale_y} 1."/>
        </geometry>
        <material name="grey">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
      <collision name="${prefix}index_finger_02_collision">
        <origin xyz="0 ${sign_y * 0.02} 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/collision/index_finger_02_collision.stl" scale="1. ${scale_y} 1."/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.00358"/>
        <inertia ixx="2.0187e-07" ixy="${sign_y * -1.0835e-07}" ixz="1.1700e-09" iyy="2.2409e-07" iyz="${sign_y * -9.8000e-10}" izz="3.1634e-07"/>
      </inertial>
    </link>
    <xacro:gazebo_contact_settings ref_link="${prefix}index_finger_02" contacts="5"/>

    <!-- Middle Finger 01 -->
    <joint name="${prefix}middle_finger_joint_01" type="revolute">
      <origin xyz="-0.0258459 ${sign_y * 0.1194414} 0.0158789" rpy="-0.0523599 0. 0."/>
      <parent link="${prefix}palm"/>
      <child link="${prefix}middle_finger_01"/>
      <axis xyz="1. 0. 0."/>
      <limit lower="${radians(hand_grasp_min)}" upper="${radians(hand_grasp_max)}" effort="10" velocity="1"/>
      <dynamics damping="0.1" friction="0.1"/>
      <mimic joint="${prefix}thumb_finger_joint_01" multiplier="1.0" offset="0"/>
    </joint>

    <link name="${prefix}middle_finger_01">
      <visual name="${prefix}middle_finger_01_visual">
        <origin xyz="0 ${sign_y * 0.02035} 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/visual/middle_finger_01.obj" scale="1. ${scale_y} 1."/>
        </geometry>
        <material name="grey">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
      <collision name="${prefix}middle_finger_01_collision">
        <origin xyz="0 ${sign_y * 0.02035} 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/collision/middle_finger_01_collision.stl" scale="1. ${scale_y} 1."/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.01980"/>
        <inertia ixx="4.4729e-06" ixy="${sign_y * -4.7790e-07}" ixz="1.8634e-07" iyy="6.0121e-06" iyz="${sign_y * -2.8300e-08}" izz="2.5352e-06"/>
      </inertial>
    </link>
    <xacro:gazebo_contact_settings ref_link="${prefix}middle_finger_01" contacts="5"/>

    <!-- Middle Finger 02 -->
    <joint name="${prefix}middle_finger_joint_02" type="revolute">
      <origin xyz="-0.0044047 ${sign_y * 0.0407368} 0.0001436" rpy="-0.4363323 0. 0."/>
      <parent link="${prefix}middle_finger_01"/>
      <child link="${prefix}middle_finger_02"/>
      <axis xyz="1. 0. 0."/>
      <limit lower="${radians(hand_grasp_min)}" upper="${radians(hand_grasp_max)}" effort="10" velocity="1"/>
      <dynamics damping="0.1" friction="0.1"/>
      <mimic joint="${prefix}thumb_finger_joint_01" multiplier="1.0" offset="0"/>
    </joint>

    <link name="${prefix}middle_finger_02">
      <visual name="${prefix}middle_finger_02_visual">
        <origin xyz="0 ${sign_y * 0.02} 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/visual/middle_finger_02.obj" scale="1. ${scale_y} 1."/>
        </geometry>
        <material name="grey">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
      <collision name="${prefix}middle_finger_02_collision">
        <origin xyz="0 ${sign_y * 0.02} 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/collision/middle_finger_02_collision.stl" scale="1. ${scale_y} 1."/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.01233"/>
        <inertia ixx="2.43846e-06" ixy="${sign_y * -3.8428e-07}" ixz="1.3958e-07" iyy="2.37996e-06" iyz="${sign_y * -4.33e-09}" izz="1.10077e-06"/>
      </inertial>
    </link>
    <xacro:gazebo_contact_settings ref_link="${prefix}middle_finger_02" contacts="5"/>

    <!-- Thumb Body -->
    <joint name="${prefix}thumb_body_joint" type="revolute">
      <origin xyz="0.0216806 ${sign_y * 0.0084182} -0.0134265" rpy="0. 0. 0."/>
      <parent link="${prefix}palm"/>
      <child link="${prefix}thumb_body"/>
      <axis xyz="0. 1. 0."/>
      <limit lower="${radians(-40.0)}" upper="${radians(20.0)}" effort="100" velocity="1"/>
    </joint>

    <link name="${prefix}thumb_body">
      <visual name="${prefix}thumb_body_visual">
        <origin xyz="0.0151813 ${sign_y * 0.0237114} -0.0441186" rpy="-2.1071804 -1.5505114 2.1039207"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/visual/thumb_body_01.obj" scale="1. ${scale_y} 1."/>
        </geometry>
        <material name="grey">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
      <collision name="${prefix}thumb_body_collision">
        <origin xyz="0.0151813 ${sign_y * 0.0237114} -0.0441186" rpy="-2.1071804 -1.5505114 2.1039207"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/collision/thumb_body_01_collision.stl" scale="1. ${scale_y} 1."/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.08669"/>
        <inertia ixx="0.00002521" ixy="${sign_y * -0.00000761}" ixz="0.00000008" iyy="0.00004292" iyz="${sign_y * -0.00000011}" izz="0.00005837"/>
      </inertial>
    </link>
    <xacro:gazebo_contact_settings ref_link="${prefix}thumb_body" contacts="5"/>

    <!-- Thumb Finger 01 -->
    <joint name="${prefix}thumb_finger_joint_01" type="revolute">
      <origin xyz="0.0001008 ${sign_y * 0.0590424} -0.046844" rpy="-0.9250245 0. 0."/>
      <parent link="${prefix}thumb_body"/>
      <child link="${prefix}thumb_finger_01"/>
      <axis xyz="-1. 0. 0."/>
      <limit lower="${radians(hand_grasp_min)}" upper="${radians(hand_grasp_max)}" effort="10" velocity="1"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <link name="${prefix}thumb_finger_01">
      <visual name="${prefix}thumb_finger_01_visual">
        <origin xyz="0 ${sign_y * 0.0207} 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/visual/thumb_finger_01.obj" scale="1. ${scale_y} 1."/>
        </geometry>
        <material name="grey">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
      <collision name="${prefix}thumb_finger_01_collision">
        <origin xyz="0 ${sign_y * 0.0207} 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/collision/thumb_finger_01_collision.stl" scale="1. ${scale_y} 1."/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.00528"/>
        <inertia ixx="5.9811e-07" ixy="${sign_y * -1.8755e-07}" ixz="1.9300e-09" iyy="3.3230e-07" iyz="${sign_y * -3.3100e-09}" izz="6.6084e-07"/>
      </inertial>
    </link>
    <xacro:gazebo_contact_settings ref_link="${prefix}thumb_finger_01" contacts="5"/>

    <!-- Thumb Finger 02 -->
    <joint name="${prefix}thumb_finger_joint_02" type="revolute">
      <origin xyz="0.0003017 ${sign_y * 0.0413844} 0.0051685" rpy="0.5235988 0. 0."/>
      <parent link="${prefix}thumb_finger_01"/>
      <child link="${prefix}thumb_finger_02"/>
      <axis xyz="-1. 0. 0."/>
      <limit lower="${radians(hand_grasp_min)}" upper="${radians(hand_grasp_max)}" effort="10" velocity="1"/>
      <dynamics damping="0.1" friction="0.1"/>
      <mimic joint="${prefix}thumb_finger_joint_01" multiplier="1.0" offset="0"/>
    </joint>

    <link name="${prefix}thumb_finger_02">
      <visual name="${prefix}thumb_finger_02_visual">
        <origin xyz="0 ${sign_y * 0.02} 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/visual/thumb_finger_02.obj" scale="1. ${scale_y} 1."/>
        </geometry>
        <material name="grey">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
      <collision name="${prefix}thumb_finger_02_collision">
        <origin xyz="0 ${sign_y * 0.02} 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://${description_pkg}/meshes/nana_v4/collision/thumb_finger_02_collision.stl" scale="1. ${scale_y} 1."/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.00358"/>
        <inertia ixx="1.7497e-07" ixy="${sign_y * -1.0207e-07}" ixz="1.1200e-09" iyy="2.5098e-07" iyz="${sign_y * -7.1000e-10}" izz="3.1634e-07"/>
      </inertial>
    </link>
    <xacro:gazebo_contact_settings ref_link="${prefix}thumb_finger_02" contacts="5"/>

  </xacro:macro>

</robot>
